#!/usr/bin/env bash
#MISE description="Build the project"
#MISE depends=["setup"]
#MISE sources=["src/**/*"]
#MISE outputs=["dist/index.js"]

bun build ./src/index.ts --outdir dist --target bun

# Copy knowledge files into dist/knowledge so they ship under dist/ in the package
rm -rf dist/knowledge
mkdir -p dist/knowledge
cp -R src/knowledge/. dist/knowledge/

# Copy reference files into dist/references so they ship under dist/ in the package
rm -rf dist/references
mkdir -p dist/references
cp -R src/references/. dist/references/

# Copy skill files into dist/skills so they ship under dist/ in the package
rm -rf dist/skills
mkdir -p dist/skills
cp -R src/skills/. dist/skills/

# Copy agent files into dist/agents so they ship under dist/ in the package
rm -rf dist/agents
mkdir -p dist/agents
cp -R src/agents/. dist/agents/

# Copy subagent files into dist/subagents so they ship under dist/ in the package
rm -rf dist/subagents
mkdir -p dist/subagents
cp -R src/subagents/. dist/subagents/

# Copy command files into dist/commands so they ship under dist/ in the package
rm -rf dist/commands
mkdir -p dist/commands
cp -R src/commands/. dist/commands/

# If you need to exlude some packages from your bundle, you can use the --external flag. For example, to exclude the "lodash" package, you can run:
# bun build ./src/index.ts --outdir dist --target bun --external lodash
