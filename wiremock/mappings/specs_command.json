{
  "mappings": [
    {
      "name": "workflow_start-specs",
      "priority": 1,
      "request": {
        "url": "/v1/chat/completions",
        "method": "POST",
        "bodyPatterns": [
        {
          "matchesJsonPath": {
            "expression": "$.messages[-1:][?(@.role == 'user')].content",
            "contains": "step of a specs → plan → build workflow by calling"
          }
        }
      ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "workflow_start-specs.json",
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8"
        }
      }
    },
    {
      "name": "workflow_start-specs",
      "priority": 1,
      "request": {
        "url": "/v1/chat/completions",
        "method": "POST",
        "bodyPatterns": [
        {
          "matchesJsonPath": {
            "expression": "$.messages[-1:][?(@.role == 'user')].content",
            "contains": "Start the **SPECS** step of the specs"
          }
        }
      ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "spec_switch.json",
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8"
        }
      }
    },
    {
      "priority": 999,
      "request": {
        "url": "/v1/chat/completions",
        "method": "POST"
      },
      "response": {
        "status": 200,
        "bodyFileName": "done.json",
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8"
        }
      }
    }
  ]
}
