{
  "mappings": [
    {
      "name": "title generation",
      "scenarioName": "specs-single",
      "request": {
        "url": "/v1/chat/completions",
        "method": "POST",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.messages[-2:-1][?(@.role == 'user')].content",
              "contains": "Generate a title for this conversation:"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "title.json",
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8"
        }
      },
      "persistent": true,
      "insertionIndex": 2
    }
  ]
}
