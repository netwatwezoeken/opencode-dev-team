{
  "mappings": [
    {
      "name": "workflow_advance_specs_approved_first",
      "priority": 1,
      "request": {
        "url": "/v1/chat/completions",
        "method": "POST",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.messages[-1:][?(@.role == 'user')].content",
              "contains": "spec approved"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "bodyFileName": "workflow_advance-specs-approved.json",
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8"
        }
      }
    }
  ]
}
